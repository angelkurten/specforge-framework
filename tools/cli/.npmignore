scripts/
# Compiled scripts/, including prepublish.js — it takes a parameterized
# bundle root and recursively deletes it, so it must never reach an adopter.
# package.json's `files` allowlist already excludes it, so this line is
# defence-in-depth rather than the mechanism PRD-005 § 8 names.
dist-scripts/
tsconfig.json
tsconfig.scripts.json
vitest.config.ts
.npmignore
node_modules/

# pnpm's default package-import-method varies by platform (clone on macOS
# APFS, hardlink on Linux ext4/GitHub Actions runners). A hardlinked
# node_modules/<dep> produces tar hard-link entries when npm packs this
# package for publish, and the npm registry rejects those outright
# (E415 "Hard link is not allowed") -- found when v0.15.0's CI publish
# failed on exactly this, despite an identical-looking local pack
# succeeding on macOS's clone-based default. `copy` is the one import
# method with no platform-dependent tar representation.
package-import-method=copy
